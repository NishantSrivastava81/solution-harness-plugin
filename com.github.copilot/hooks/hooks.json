{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/plugin-hook.cjs\" sessionStart",
        "timeoutSec": 30
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/plugin-hook.cjs\" preToolUse",
        "timeoutSec": 30
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/plugin-hook.cjs\" postToolUse",
        "timeoutSec": 30
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/plugin-hook.cjs\" agentStop",
        "timeoutSec": 30
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/plugin-hook.cjs\" subagentStop",
        "timeoutSec": 30
      }
    ]
  }
}
